  m_Script: {fileID: 11500000, guid: dcc33513ca72db1418b8b44dd6d5aa95, type: 3}
  m_Name: Oso
  m_EditorClassIdentifier: Assembly-CSharp::DialogueData
  lines:
  - speaker: Oso de Anteojos
    portrait: {fileID: 6120914730915384989, guid: e5a971fc39c3037479eca94363773240, type: 3}
    text: "Hola aventurero, bienvenido al centro de formaci\xF3n."
  - speaker: Yo
    portrait: {fileID: 8209660055318790805, guid: 4fdc9d4121e9d3f44adf55ff3d2177c8, type: 3}
    text: "\xBFqu\xE9 es un centro de formaci\xF3n?"
  - speaker: Oso de anteojos
    portrait: {fileID: 6120914730915384989, guid: e5a971fc39c3037479eca94363773240, type: 3}
    text: Es una sede de aprendizaje...
  - speaker: Yo
    portrait: {fileID: 8209660055318790805, guid: 4fdc9d4121e9d3f44adf55ff3d2177c8, type: 3}
    text: Que interesante!
  - speaker: Oso de anteojos
    portrait: {fileID: 6120914730915384989, guid: e5a971fc39c3037479eca94363773240, type: 3}
    text: "Ven, S\xCDGUEME, te ense\xF1ar\xE9 este maravilloso lugar."
